FROM php:8.2-fpm

WORKDIR /var/www

# Configurar timezone
RUN ln -sf /usr/share/zoneinfo/America/Manaus /etc/localtime
RUN echo "America/Manaus" > /etc/timezone
RUN dpkg-reconfigure --frontend noninteractive tzdata

# Instala dependências
RUN apt-get update \
	# gd
	&& apt-get install -y \
	build-essential \
	openssl \
	libfreetype6-dev \
	libjpeg-dev \
	libpng-dev \
	libwebp-dev \
	zlib1g-dev \
	libzip-dev \
	gcc \
	g++ \
	make \
	vim \
	unzip \
	curl \
	git \
	jpegoptim \
	optipng \
	pngquant \
	gifsicle \
	locales \
	libonig-dev \
	nginx \
	poppler-utils \
	cron \
	chromium \
	fonts-liberation \
	libatk-bridge2.0-0 \
	libatk1.0-0 \
	libcairo2 \
	libcups2 \
	libdrm2 \
	libgbm1 \
	libgtk-3-0 \
	libnspr4 \
	libnss3 \
	libpango-1.0-0 \
	libx11-xcb1 \
	libxcb-dri3-0 \
	libxcomposite1 \
	libxdamage1 \
	libxrandr2 \
	xdg-utils \
	# Dependências para Imagick
	libmagickwand-dev \
	&& docker-php-ext-configure gd --enable-gd --with-freetype --with-jpeg \
	&& docker-php-ext-install gd \
	# gmp
	&& apt-get install -y --no-install-recommends libgmp-dev \
	&& docker-php-ext-install gmp \
	# pdo_mysql
	&& docker-php-ext-install pdo_mysql mbstring \
	# pdo
	&& docker-php-ext-install pdo \
	# mysqli
	&& docker-php-ext-install mysqli \
	&& docker-php-ext-enable mysqli \
	# opcache
	&& docker-php-ext-enable opcache \
	# exif
    && docker-php-ext-install exif \
    && docker-php-ext-install sockets \
    && docker-php-ext-install pcntl \
    && docker-php-ext-install bcmath \
	# zip
	&& docker-php-ext-install zip \
	# Instala Imagick via pecl
	&& pecl install imagick \
	&& docker-php-ext-enable imagick \
	# Limpeza de cache
	&& apt-get autoclean -y \
	&& rm -rf /var/lib/apt/lists/* \
	&& rm -rf /tmp/pear/

# Instala Node.js e Yarn
RUN curl -fsSL https://deb.nodesource.com/setup_lts.x | bash - && \
	apt-get install -y nodejs && \
	npm install -g npm@latest && \
	npm install -g yarn

# Instala Composer	
RUN php -r "copy('https://getcomposer.org/installer', 'composer-setup.php');" \
	&& php composer-setup.php \
	&& php -r "unlink('composer-setup.php');" \
	&& mv composer.phar /usr/local/bin/composer

# Copia o script de inicialização
COPY ./.docker/prod/build.prod.sh /var/www/.docker/prod/build.prod.sh
RUN chmod +x /var/www/.docker/prod/build.prod.sh

# Define o caminho do Chromium para o Puppeteer
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

EXPOSE 80

CMD [ "sh", "./.docker/prod/build.prod.sh" ]